# Pinned upstream sources. Every download is checked against its pinned sha256.
# zlib and nginx are also checked against their upstream GPG signature from a
# pinned key (build/keys/); pkg-oss, njs and QuickJS are unsigned GitHub
# archives, so for them the sha256 pin is the only check.

# --- zlib: version bump 1.2.13 -> 1.4 (CVE-2026-27171) -----------------------
# Debian bookworm ships 1:1.2.13.dfsg-1 and marks CVE-2026-27171 as not fixed.
# 1.3.2 is the first release with the fix, but 1.3.1.2..1.3.2 are affected by
# CVE-2026-85091 (gz_vacate), so we target 1.4, which fixes both.
ZLIB_VERSION=1.4
ZLIB_URL=https://github.com/madler/zlib/releases/download/v1.4/zlib-1.4.tar.gz
ZLIB_SHA256=02dd159783677a749c04adbdd02b55b8a2bcc7e054f51b76b549199a916ad584
ZLIB_GPG_FPR=5ED46A6721D365587791E2AA783FCD8E58BCAFBA
# Epoch "1:" is required: Debian's version is 1:1.2.13..., and without the
# epoch dpkg would consider 1.4 *older*. "+echo1" marks our rebuild.
ZLIB_DEB_VERSION=1:1.4-0+echo1

# --- nginx 1.25.5 + backport of CVE-2025-23419 (build/patches/) -------------
# Same upstream version as nginx:1.25-bookworm; only our patches differ.
NGINX_VERSION=1.25.5
NGINX_URL=https://nginx.org/download/nginx-1.25.5.tar.gz
NGINX_SHA256=2fe2294f8af4144e7e842eaea884182a84ee7970e11046ba98194400902bbec0
NGINX_GPG_FPR=43387825DDB1BB97EC36BA5D007C8D7C15D87369   # Roman Arutyunyan (nginx.org/keys/arut.key)

# nginx.org's packaging recipe (pkg-oss: debian/rules, control, configs,
# maintainer scripts) - the same tag the original packages were built from.
# build-nginx.sh runs it as-is; package versions come from its changelog plus
# our "+echo1" entry (e.g. nginx 1.25.5-1~bookworm+echo1).
# GitHub tag archives are not GPG-signed: pinned by sha256 only.
PKGOSS_TAG=1.25.5-1
PKGOSS_URL=https://github.com/nginx/pkg-oss/archive/refs/tags/1.25.5-1.tar.gz
PKGOSS_SHA256=53070dffc727af6fc9ac18b56cfcf294ecdce222264e26cc9320ec96b80fc9b3

# njs module source (same version as the original image; its own CVEs are
# residual risk). pkg-oss pins it to an hg.nginx.org archive that no longer
# exists, so we pin the GitHub tag archive instead.
NJS_VERSION=0.8.4
NJS_URL=https://github.com/nginx/njs/archive/refs/tags/0.8.4.tar.gz
NJS_SHA256=fe197e254204c15e9f1df0acf375add57be3416901ec8d7b87319dccb490f90d
# QuickJS (engine of the /usr/bin/njs CLI) is fetched by pkg-oss itself with
# git and checked against the commit hash pkg-oss pins (contrib/src/quickjs).
